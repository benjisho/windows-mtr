# Keep source and repository documentation in the LF form expected by the
# Rust formatter and CI, regardless of a developer's Windows autocrlf setting.
*.rs text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf

# PowerShell scripts are consumed natively on Windows.
*.ps1 text eol=crlf
